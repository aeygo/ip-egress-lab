# Egress A (EC2). On the instance this file lives at /etc/ip-egress-lab/egress-a.env (mode 640).

# Bind to loopback so only Caddy on the same host can reach the service.
HOST=127.0.0.1
PORT=3000

# Secrets are left empty on purpose: the service refuses to start until both are set.
# Generate each with: openssl rand -hex 32

# Verifies requests from Gateway. Must equal Gateway's GATEWAY_EGRESS_SECRET.
GATEWAY_EGRESS_SECRET=

# Signs requests to Target. Must equal Target's EGRESS_TARGET_SECRET and differ from the secret above.
EGRESS_TARGET_SECRET=

# The only destination Egress A will ever call. No query string or fragment.
TARGET_EVENTS_URL=https://ip-egress-lab-1.onrender.com/v1/events

# 1 behind Caddy on the same instance. 3 if this service is deployed on Render instead.
TRUST_PROXY_HOPS=1

# Render free instances can take 30 s or more to wake; raise this if Target is cold-starting.
TARGET_TIMEOUT_MS=20000

# Must match Gateway's list.
APPROVED_QUERY_PARAMS=irclickid,irgwc,lab_click_id,utm_source,utm_medium,utm_campaign,utm_content,utm_term

SIGNATURE_TOLERANCE_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=3600
IDEMPOTENCY_MAX_ENTRIES=10000

# Per-IP limit for /self-test.
RATE_LIMIT_PER_MINUTE=30

# Gateway (Render). Copy to .env for local runs; set these in the Render dashboard for deploys.

# Render injects PORT. HOST defaults to 0.0.0.0.
PORT=3000
# HOST=0.0.0.0

# Egress A events endpoint. https is required except for localhost.
EGRESS_EVENTS_URL=https://egress-a.example.com/v1/events

# HMAC secret shared with Egress A only. Generate with: openssl rand -hex 32
# Left empty on purpose: the service refuses to start until a real secret is set.
GATEWAY_EGRESS_SECRET=

# Number of reverse proxies in front of this service whose X-Forwarded-For entries are trusted.
# Measured on Render: 3 (Cloudflare edge, Render load balancer, local sidecar). Use 0 locally.
TRUST_PROXY_HOPS=3

# Must exceed Egress A's TARGET_TIMEOUT_MS so failures are attributed to the right hop.
EGRESS_TIMEOUT_MS=25000

# Comma-separated query parameters forwarded unchanged. Must include irclickid.
APPROVED_QUERY_PARAMS=irclickid,irgwc,lab_click_id,utm_source,utm_medium,utm_campaign,utm_content,utm_term

# Per-IP limit for /direct and /egress-ip.
RATE_LIMIT_PER_MINUTE=60

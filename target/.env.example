# Target (Render). Copy to .env for local runs; set these in the Render dashboard for deploys.

PORT=3000
# HOST=0.0.0.0

# Verifies requests from Egress A. Must equal Egress A's EGRESS_TARGET_SECRET.
# Left empty on purpose: the service refuses to start until a real secret is set.
EGRESS_TARGET_SECRET=

# Measured on Render: 3. With 3, resolved_source_ip is Egress A's public (Elastic) IP.
TRUST_PROXY_HOPS=3

SIGNATURE_TOLERANCE_SECONDS=300

# Per-IP limit for /inspect and /test-page.
RATE_LIMIT_PER_MINUTE=60
